# iperf3 server for the survey rigs. Copy to /etc/systemd/system/, then:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now viabot-iperf3
#
# Authentication is not optional here. This port is reachable from the whole
# internet — it has to be, because the rig arrives from a different carrier
# address every time — and an open iperf3 server is a bandwidth allowance that
# anyone who finds it can spend.
[Unit]
Description=iperf3 server for ViaBot coverage surveys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=viabot
Group=viabot
ExecStart=/usr/bin/iperf3 --server --port 5201 \
  --rsa-private-key-path /etc/viabot/iperf3_private.pem \
  --authorized-users-path /etc/viabot/iperf3_users.csv
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
